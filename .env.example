# Copy this file to `.env` and fill in the values. Never commit `.env`.

# ── Supabase (browser-safe) ────────────────────────────────────────────────
# Dashboard → Project Settings → API (or the "Connect" button).
# VITE_ variables are bundled into the client; these two are public by design
# and protected by the Row Level Security policies in supabase/schema.sql.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...) or the legacy "anon" key both work.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Gemini (server-only — no VITE_ prefix, never reaches the browser) ──────
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Optional. Defaults to the `gemini-flash-latest` alias; pin a specific
# model id (e.g. gemini-3.5-flash) if you want frozen behaviour.
GEMINI_MODEL=

# ── Mobile app (Android) ───────────────────────────────────────────────────
# URL the Android app loads. Leave empty for the emulator default (http://10.0.2.2:3000);
# must be your deployed https URL before building an APK you hand out.
CAP_SERVER_URL=

# ── App updates (server-only) ──────────────────────────────────────────────
# Public GitHub repo whose latest Release holds the newest APK (owner/name).
ANDROID_RELEASES_REPO=
# Shells older than this see a blocking "Update required" screen. Raise only for breaking changes.
ANDROID_MIN_VERSION=
# Fallbacks when you don't use GitHub Releases:
ANDROID_LATEST_VERSION=
ANDROID_UPDATE_URL=
